# Lead Form Email Dispatch (SMTP Configuration)
# Amazon SES Example (e.g. Mumbai ap-south-1 or N. Virginia us-east-1):
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<Your_SES_SMTP_Username_AKIA...>
# SMTP_PASS=<Your_SES_SMTP_Password_BMZ...>
# SMTP_FROM="Anand Rathi Wealth IFSC <enquiry@rathi.com>"
