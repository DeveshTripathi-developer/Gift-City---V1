# Environment Variables

# Gemini AI API Key
GEMINI_API_KEY=

# Lead Form Email Dispatch (SMTP Configuration)
# When configured, lead submissions from "Connect With Us" are sent live via SMTP.
# Example: smtp.gmail.com with an App Password, or AWS SES, SendGrid, Resend, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Anand Rathi Wealth IFSC <leads@rathi.com>"

# Lead Notification Recipients (1 Primary TO, 2 CC)
LEAD_EMAIL_TO=deveshtripathi900@gmail.com
LEAD_EMAIL_CC1=giftcity@rathi.com
LEAD_EMAIL_CC2=compliance.giftcity@rathi.com
